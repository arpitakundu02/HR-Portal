# ============================================================
# backend/.env.example
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# Flask
FLASK_ENV=development
SECRET_KEY=change_me_to_a_long_random_secret_key

# JWT
JWT_SECRET_KEY=change_me_to_another_long_random_secret

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=hr_portal
DB_PORT=3306

# SMTP (Email Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@gmail.com
ADMIN_NOTIFY_EMAIL=admin@yourcompany.com

# Office Geolocation (for Attendance Check-In Radius)
OFFICE_LATITUDE=28.6139
OFFICE_LONGITUDE=77.2090
OFFICE_RADIUS_METERS=200
